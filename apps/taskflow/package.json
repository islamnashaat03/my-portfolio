{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests scripts vite.config.js",
    "format:check": "prettier --check src tests scripts vite.config.js",
    "publish:assets": "npm run build && node scripts/publish-assets.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "3.6.2",
    "vite": "^7.2.2"
  }
}
